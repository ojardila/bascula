{
  "name": "bascula",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm --workspace apps/mobile run start",
    "android": "npm --workspace apps/mobile run android",
    "ios": "npm --workspace apps/mobile run ios",
    "test": "npm --workspace apps/mobile test",
    "typecheck": "npm --workspace apps/mobile exec tsc -- --noEmit"
  }
}
