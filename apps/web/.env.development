# Which API this dev server talks to. The choice is EXPLICIT: there is no
# fallback, no "mocks if the server seems down". A mode that can change by
# itself is a mode nobody can reason about at four in the afternoon.
#
#   VITE_USE_MOCKS=true   MSW answers in the browser. Nothing leaves the tab.
#                         The seeded coffee farm, a banner saying so, and a
#                         world that resets on reload.
#
#   VITE_USE_MOCKS=false  Requests go to VITE_API_URL through the Vite proxy.
#                         Start the server first:
#
#     cd services/api && make up && make migrate && \
#       PORT=8099 DATABASE_URL="postgres://bascula_api:bascula_api_dev@localhost:5433/bascula?sslmode=disable" \
#       go run ./cmd/api
#
# The proxy is not optional. The API mounts no CORS middleware, so a browser
# on :5173 cannot call :8099 directly — the preflight comes back bare and the
# browser discards the response before our code sees it. `vite.config.ts`
# forwards /v1 and /health to VITE_API_URL, which makes it same-origin and
# means there is no preflight to fail.
VITE_USE_MOCKS=true

# Where the proxy points. Read by vite.config.ts, never fetched by the app.
VITE_API_URL=http://localhost:8099

# The prefix the app puts on every path. Leave it empty so requests are
# relative and the proxy can see them — and so MSW matches the same URLs the
# real mode uses. Set it only for a server that does send CORS headers.
VITE_API_BASE_URL=
